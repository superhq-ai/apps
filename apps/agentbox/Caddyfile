{
	admin off
	auto_https off
}
:{$PORT} {
	@crossOrigin {
		header Origin *
		not header Origin {$APP_URL}
	}
	respond @crossOrigin "Forbidden origin" 403
	@entry {
		path /
		not query connected=1
	}
	handle @entry {
		reverse_proxy 127.0.0.1:18766
	}
	handle /setup* {
		reverse_proxy 127.0.0.1:18766
	}
	handle {
		reverse_proxy 127.0.0.1:18765 {
			header_up X-Agentbox-Token {$AGENTBOX_BACKEND_TOKEN}
		}
	}
}
